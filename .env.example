# Local stack (docker-compose.yml). Copy to .env. These values name VeriDoc's own
# project, ports and credentials, so the stack can run beside the old DigiVault
# containers (digivault-postgres :5434, digivault-minio :9000/:9001). Dev values only.
VERIDOC_DB_USER=veridoc
VERIDOC_DB_PASSWORD=veridoc
VERIDOC_DB_NAME=veridoc
VERIDOC_POSTGRES_PORT=5440
VERIDOC_MINIO_USER=veridoc
VERIDOC_MINIO_PASSWORD=veridoc123
VERIDOC_MINIO_PORT=9100
VERIDOC_MINIO_CONSOLE_PORT=9101

# Migration/owner role for `prisma migrate`; must match the values above.
DATABASE_URL="postgresql://veridoc:veridoc@localhost:5440/veridoc?schema=public"

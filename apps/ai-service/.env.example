PORT=8001

# --- VeriDoc settings (app/settings.py) ------------------------------------
# "fake" replays recorded model output; "local" runs the local model and
# requires MODEL_FILE_PATH and LLAMA_SERVER_PATH. Default: fake.
MODEL_MODE=fake
# Local model: weights file (never committed; see models/manifest.json for the
# pinned SHA-256 the file must match) and the llama-server binary.
# MODEL_FILE_PATH=
# MODEL_SHA256=
# LLAMA_SERVER_PATH=
# PLAYBOOK_DIR=playbooks
# REDACTION_RULES_FILE=
# DATA_DIR=data
# DEMO_MODE_BADGE=Demo mode: recorded model output
